# Konfigurasi publik untuk proses build Flutter.
# Jangan menaruh password, bearer token, API key privat, atau credential lain
# di file ini maupun di .env.
APP_NAME=Tali Silsilah
APP_ENV=development

# Gunakan base URL API tanpa trailing slash.
API_BASE_URL=https://api-alusrah.oproject.id/api

# Gunakan trailing slash agar URL file storage dapat digabung dengan aman.
API_STORAGE_URL=https://api-alusrah.oproject.id/storage/

# Timeout request Dio dalam detik.
NETWORK_TIMEOUT_SECONDS=20
